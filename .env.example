# Safe Route Navigator Environment Variables
PROJECT_NAME="Safe Route Navigator"
VERSION="1.0.0"

# Database Connection
# SQLite (Zero-config local fallback):
DATABASE_URL=sqlite:///./safe_route.db
# PostgreSQL / PostGIS (Docker Compose / Production):
# DATABASE_URL=postgresql://saferoute_user:saferoute_password@localhost:5432/saferoute_db

# Security
JWT_SECRET=super-secret-safe-route-key-2026-hackathon
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Risk Engine Parameters
DECAY_LAMBDA=0.08
REPORT_CLUSTER_RADIUS_METERS=150.0
MAX_RISK_PENALTY_GAMMA=0.25

# Optional External API Integrations (Gracefully falls back to synthetic GIS graph if unset)
OSRM_URL=
OPENROUTESERVICE_API_KEY=
WEATHER_API_KEY=
